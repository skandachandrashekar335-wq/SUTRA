# Root-level .gitignore
# This repo is rooted at the home directory.
# Exclude build artifacts, dependencies, and secrets from all subprojects.

# Node
**/node_modules/
**/.pnp
**/.pnp.*
**/.yarn/*
!**/.yarn/patches
!**/.yarn/plugins
!**/.yarn/releases
!**/.yarn/versions

# Next.js build output
**/.next/
**/out/
**/build/

# Environment files (secrets)
**/.env
**/.env.local
**/.env.*.local
**/.env.local.save

# OS
**/.DS_Store
**/Thumbs.db

# Logs
**/npm-debug.log*
**/yarn-debug.log*
**/yarn-error.log*

# TypeScript
**/*.tsbuildinfo

# Vercel
**/.vercel

# Coverage
**/coverage/

# Python
**/__pycache__/
**/*.pyc
**/*.pyo
**/.venv/
**/venv/

# Misc
**/.cache/
